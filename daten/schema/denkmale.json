{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Denkmale, Teil Register (Wikidata, NID, Gminna ewidencja zabytków)",
 "description": "Teilmenge der Denkmale mit Lage, Bauzeitklasse und Gebäudebezug aus BDOT10k. Keine Flächenaussage zu Baujahren. Keine Kennung, keine Adresse, kein Name.",
 "x-datei": "denkmale.js",
 "x-global": "^KIEZ_DENKMALE$",
 "type": "object",
 "required": [
  "stand",
  "teilmenge",
  "flaechenaussage",
  "klassen",
  "quellen",
  "zaehlung",
  "objekte",
  "kamienice",
  "ortsmarken"
 ],
 "additionalProperties": false,
 "properties": {
  "stand": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "fixture": {
   "const": true
  },
  "teilmenge": {
   "const": true
  },
  "flaechenaussage": {
   "const": false
  },
  "klassen": {
   "const": [
    "vor_1800",
    "1800_1866",
    "1867_1918",
    "1919_1945",
    "1946_1989",
    "ab_1990"
   ]
  },
  "quellen": {
   "type": "object",
   "required": [
    "wd",
    "nid",
    "gez"
   ],
   "additionalProperties": false,
   "properties": {
    "wd": {
     "type": "object",
     "required": [
      "vorhanden"
     ],
     "additionalProperties": false,
     "properties": {
      "vorhanden": {
       "type": "boolean"
      },
      "datei": {
       "type": "string"
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "abruf": {
       "type": "string",
       "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
       "description": "Abruftag aus eingang/HERKUNFT.md; stand der Datei ist der jüngste Abruftag der vorhandenen Register"
      },
      "spalten": {
       "type": "object"
      },
      "vermerk": {
       "const": "Wikidata, CC0 1.0",
       "description": "Quellenvermerk für Seite, Karte und Downloads; CC0 verlangt keine Nennung, der Atlas nennt die Quelle trotzdem"
      }
     }
    },
    "nid": {
     "type": "object",
     "required": [
      "vorhanden"
     ],
     "additionalProperties": false,
     "properties": {
      "vorhanden": {
       "type": "boolean"
      },
      "datei": {
       "type": "string"
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "abruf": {
       "type": "string",
       "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
       "description": "Abruftag aus eingang/HERKUNFT.md; stand der Datei ist der jüngste Abruftag der vorhandenen Register"
      },
      "spalten": {
       "type": "object"
      }
     }
    },
    "gez": {
     "type": "object",
     "required": [
      "vorhanden"
     ],
     "additionalProperties": false,
     "properties": {
      "vorhanden": {
       "type": "boolean"
      },
      "datei": {
       "type": "string"
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "abruf": {
       "type": "string",
       "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
       "description": "Abruftag aus eingang/HERKUNFT.md; stand der Datei ist der jüngste Abruftag der vorhandenen Register"
      },
      "spalten": {
       "type": "object"
      }
     }
    }
   }
  },
  "zaehlung": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "additionalProperties": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "objekte": {
   "type": "object",
   "required": [
    "type",
    "features"
   ],
   "properties": {
    "type": {
     "const": "FeatureCollection"
    },
    "features": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "type",
       "geometry",
       "properties"
      ],
      "additionalProperties": false,
      "properties": {
       "type": {
        "const": "Feature"
       },
       "geometry": {
        "type": "object",
        "required": [
         "type",
         "coordinates"
        ],
        "additionalProperties": false,
        "properties": {
         "type": {
          "const": "Point"
         },
         "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
           "type": "number"
          }
         }
        }
       },
       "properties": {
        "type": "object",
        "required": [
         "q",
         "ep",
         "w",
         "mfh",
         "del"
        ],
        "additionalProperties": false,
        "properties": {
         "q": {
          "type": "array",
          "minItems": 1,
          "items": {
           "enum": [
            "wd",
            "nid",
            "gez"
           ]
          }
         },
         "ep": {
          "enum": [
           "vor_1800",
           "1800_1866",
           "1867_1918",
           "1919_1945",
           "1946_1989",
           "ab_1990",
           null
          ],
          "description": "Bauzeitklasse; nie ein Einzeljahr (Datenschutzgrenze, pruefen/DZ_protokoll.md)"
         },
         "w": {
          "type": [
           "boolean",
           "null"
          ],
          "description": "Gebäudetreffer ist Wohngebäude (FOBUD); null = kein Gebäudetreffer"
         },
         "mfh": {
          "type": [
           "boolean",
           "null"
          ],
          "description": "Gebäudetreffer ist Mehrfamilienhaus (PFBUD); null = kein Gebäudetreffer"
         },
         "del": {
          "type": [
           "string",
           "null"
          ],
          "description": "Delegatura (OT_ADJA_A, Name polnisch), null = keiner zugeordnet"
         }
        }
       }
      }
     }
    }
   }
  },
  "kamienice": {
   "type": "object",
   "additionalProperties": {
    "type": "integer",
    "minimum": 0
   },
   "description": "Mehrfamilienhäuser mit Denkmalbezug je Delegatura (\"-\" = keiner zugeordnet)"
  },
  "ortsmarken": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "schluessel",
     "geometry",
     "lage_geprueft",
     "quelle"
    ],
    "additionalProperties": false,
    "properties": {
     "schluessel": {
      "const": "kosciuszki_18"
     },
     "geometry": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "type": "object",
        "required": [
         "type",
         "coordinates"
        ],
        "additionalProperties": false,
        "properties": {
         "type": {
          "const": "Point"
         },
         "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
           "type": "number"
          }
         }
        }
       }
      ]
     },
     "lage_geprueft": {
      "type": "boolean"
     },
     "quelle": {
      "enum": [
       null,
       "osm"
      ]
     }
    }
   }
  },
  "sichtpruefung": {
   "description": "Stand der Sichtprüfung am Luftbild (Prüfprotokoll Denkmale, Regel 7, Nachträge 3 und 4): geprueft false, solange kein Mensch die Stichprobe ausgewertet hat (startwert nennt die ausstehende Runde; die Seiten zeigen die Punkte dann als ungeprüft); geprueft true mit Datum, Art der Prüfung und Quoten aus belege/DZ_sichtpruefung.json. Die Quote gilt für die Ebene (Zufallsstichprobe), nicht für den einzelnen Punkt; Zuordnung zum Gebäude nicht geprüft. Fehlt bei Beispieldaten.",
   "anyOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "geprueft",
      "stichprobe",
      "startwert"
     ],
     "properties": {
      "geprueft": {
       "const": false
      },
      "stichprobe": {
       "type": "integer",
       "minimum": 0
      },
      "startwert": {
       "type": "integer"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "geprueft",
      "stichprobe",
      "startwert",
      "datum",
      "pruefer_rolle",
      "grundlage",
      "ergebnis"
     ],
     "properties": {
      "geprueft": {
       "const": true
      },
      "stichprobe": {
       "type": "integer",
       "minimum": 0
      },
      "startwert": {
       "type": "integer"
      },
      "datum": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "pruefer_rolle": {
       "enum": [
        "sichtpruefung_luftbild"
       ],
       "description": "Art der Prüfung, kein Name (Prüfprotokoll Denkmale, Nachtrag 4)"
      },
      "grundlage": {
       "enum": [
        "ortofotomapa"
       ]
      },
      "ergebnis": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "n",
        "lage",
        "ansicht"
       ],
       "description": "Ergebnis der Stichprobe der Registerpunkte aus Wikidata",
       "properties": {
        "n": {
         "type": "integer",
         "minimum": 0
        },
        "lage": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "ja",
          "daneben",
          "nein",
          "quote",
          "wilson95"
         ],
         "description": "Lage: Punkt steht auf dem Objekt (ja), knapp daneben, nicht dort (nein). quote = ja / alle in Prozent, eine Nachkommastelle; wilson95 = 95-%-Intervall nach Wilson in Prozent",
         "properties": {
          "ja": {
           "type": "integer",
           "minimum": 0
          },
          "daneben": {
           "type": "integer",
           "minimum": 0
          },
          "nein": {
           "type": "integer",
           "minimum": 0
          },
          "quote": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 100
          },
          "wilson95": {
           "anyOf": [
            {
             "type": "null"
            },
            {
             "type": "array",
             "minItems": 2,
             "maxItems": 2,
             "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
             }
            }
           ]
          }
         }
        },
        "ansicht": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "ja",
          "nein",
          "unklar",
          "entschieden",
          "quote",
          "wilson95"
         ],
         "description": "Ansicht: Luftbild zeigt ein Bauwerk oder eine Anlage, die zur Angabe passt. quote = ja / entschieden (ja + nein) in Prozent; unklar nicht im Nenner",
         "properties": {
          "ja": {
           "type": "integer",
           "minimum": 0
          },
          "nein": {
           "type": "integer",
           "minimum": 0
          },
          "unklar": {
           "type": "integer",
           "minimum": 0
          },
          "entschieden": {
           "type": "integer",
           "minimum": 0
          },
          "quote": {
           "type": [
            "number",
            "null"
           ],
           "minimum": 0,
           "maximum": 100
          },
          "wilson95": {
           "anyOf": [
            {
             "type": "null"
            },
            {
             "type": "array",
             "minItems": 2,
             "maxItems": 2,
             "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
             }
            }
           ]
          }
         }
        }
       }
      }
     }
    }
   ]
  }
 }
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Grundkarte: Stil der eigenen Vektorkacheln aus BDOT10k",
 "x-datei": "grundkarte.js",
 "x-global": "^KIEZ_GRUNDKARTE$",
 "x-odbl": false,
 "x-eigentuemer": "skripte/27_grundkarte.py",
 "description": "Stil der selbst gehosteten Grundkarte Kraków (Vorschlag Paket Grundkarte, docs/entscheidungen/D8.md). Keine Geodaten: nur Stilebenen, die Kachel-URL und die Schrift-URL, beide relativ zur Atlas-Wurzel (Seiten in Sprachordnern setzen ../ davor). Die Kacheln (Mapbox Vector Tile 2.1, EPSG:3857) und die SDF-Schrift erzeugt skripte/27_grundkarte.py aus BDOT10k (GUGiK, Paket 1261 Miasto Kraków); Quellenangabe nach art. 40c ust. 3 Prawo geodezyjne i kartograficzne. Kein OpenStreetMap. unten = Flächen und Linien unter den eigenen Ebenen, oben = Beschriftungen. Ohne Gebäude und ohne Sprite-Bilder. Quellschichten (source-layer): teren, zielen, woda, cieki, tory, sciezki, drogi, miejsca; Attribute k (Klasse), nazwa (Name, Polnisch wie in der Quelle), most (Brücke).",
 "type": "object",
 "additionalProperties": false,
 "required": ["stand", "quelle", "glyphs", "unten", "oben", "vermerk"],
 "properties": {
  "stand": {"type": "string", "pattern": "^BDOT10k "},
  "quelle": {
   "type": "object",
   "additionalProperties": false,
   "required": ["type", "tiles", "minzoom", "maxzoom", "bounds", "attribution"],
   "properties": {
    "type": {"const": "vector"},
    "tiles": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "pattern": "^daten/grundkarte/kacheln/\\{z\\}/\\{x\\}/\\{y\\}\\.pbf$"}},
    "minzoom": {"type": "integer", "minimum": 0, "maximum": 22},
    "maxzoom": {"type": "integer", "minimum": 0, "maximum": 22},
    "bounds": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "attribution": {"type": "string", "pattern": "BDOT10k.*Główny Urząd Geodezji i Kartografii"}
   }
  },
  "glyphs": {"type": "string", "pattern": "^daten/grundkarte/schrift/\\{fontstack\\}/\\{range\\}\\.pbf$"},
  "unten": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "#/$defs/ebene"}, {"properties": {"type": {"enum": ["fill", "line"]}}}]}},
  "oben": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "#/$defs/ebene"}, {"properties": {"type": {"const": "symbol"}}}]}},
  "vermerk": {"type": "string", "pattern": "BDOT10k.*Główny Urząd Geodezji i Kartografii"}
 },
 "$defs": {
  "ebene": {
   "type": "object",
   "required": ["id", "type", "source", "source-layer"],
   "properties": {
    "id": {"type": "string", "pattern": "^bm-"},
    "source": {"const": "bm"},
    "source-layer": {"enum": ["teren", "zielen", "woda", "cieki", "tory", "sciezki", "drogi", "miejsca"]},
    "type": {"enum": ["fill", "line", "circle", "symbol"]}
   }
  }
 }
}

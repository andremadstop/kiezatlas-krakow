{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Klima: Bodenbedeckung je 1-km-Zelle",
 "description": "1-km-Zellen des INSPIRE-Gitters (EPSG:3035, Geometrie als volle Zelle in WGS 84), die die Gemeinde Kraków schneiden. flaeche_stadt_ha und anteil_stadt: Teil der Zelle innerhalb der Stadt; ha und anteil beziehen sich nur auf diesen Teil. Unter mindestflaeche_ha in der Stadt ist anteil null (anteil_grund). Quelle BDOT10k (GUGiK), Abzeichen orientierung. Keine OpenStreetMap-Anteile, keine Einwohner.",
 "x-datei": "klimat_zellen.js",
 "x-global": "^KIEZ_KLIMAT_ZELLEN$",
 "x-eigentuemer": "skripte/35_klimat.py (Paket Klima)",
 "type": "object",
 "required": [
  "stand_daten",
  "quelle",
  "abzeichen",
  "klassen",
  "abgeleitet",
  "rechen_srid",
  "type",
  "mindestflaeche_ha",
  "features"
 ],
 "additionalProperties": false,
 "properties": {
  "type": {
   "const": "FeatureCollection"
  },
  "stand_daten": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "quelle": {
   "$ref": "#/$defs/quelle"
  },
  "abzeichen": {
   "enum": [
    "orientierung"
   ]
  },
  "klassen": {
   "type": "array",
   "minItems": 7,
   "maxItems": 7,
   "items": {
    "enum": [
     "bebauung",
     "verkehr",
     "gruen",
     "wald",
     "wasser",
     "acker",
     "sonstige"
    ]
   }
  },
  "abgeleitet": {
   "type": "object",
   "required": [
    "bebauung_verkehr",
    "gruen_wald"
   ],
   "additionalProperties": false,
   "properties": {
    "bebauung_verkehr": {
     "type": "array",
     "items": {
      "enum": [
       "bebauung",
       "verkehr",
       "gruen",
       "wald",
       "wasser",
       "acker",
       "sonstige"
      ]
     }
    },
    "gruen_wald": {
     "type": "array",
     "items": {
      "enum": [
       "bebauung",
       "verkehr",
       "gruen",
       "wald",
       "wasser",
       "acker",
       "sonstige"
      ]
     }
    }
   }
  },
  "rechen_srid": {
   "type": "integer"
  },
  "befund": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "Befunde nach pruefen/dk_protokoll.md; eine Datei mit befund wird nicht veröffentlicht."
  },
  "mindestflaeche_ha": {
   "type": "number",
   "minimum": 0
  },
  "features": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "type",
     "geometry",
     "properties"
    ],
    "additionalProperties": false,
    "properties": {
     "type": {
      "const": "Feature"
     },
     "geometry": {
      "type": "object",
      "required": [
       "type",
       "coordinates"
      ],
      "properties": {
       "type": {
        "const": "Polygon"
       }
      }
     },
     "properties": {
      "type": "object",
      "required": [
       "abdeckung",
       "ha",
       "anteil",
       "id",
       "flaeche_stadt_ha",
       "anteil_stadt"
      ],
      "additionalProperties": false,
      "properties": {
       "abdeckung": {
        "type": [
         "number",
         "null"
        ],
        "minimum": 0,
        "maximum": 100.5
       },
       "ha": {
        "$ref": "#/$defs/ha"
       },
       "anteil": {
        "$ref": "#/$defs/anteil"
       },
       "id": {
        "type": "string",
        "pattern": "^CRS3035RES1000mN\\d+E\\d+$"
       },
       "flaeche_stadt_ha": {
        "type": "number",
        "minimum": 0
       },
       "anteil_stadt": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
       },
       "anteil_grund": {
        "enum": [
         "bezugsflaeche_zu_klein"
        ]
       }
      }
     }
    }
   }
  }
 },
 "$defs": {
  "ha": {
   "type": "object",
   "required": [
    "bebauung",
    "verkehr",
    "gruen",
    "wald",
    "wasser",
    "acker",
    "sonstige"
   ],
   "additionalProperties": false,
   "properties": {
    "bebauung": {
     "type": "number",
     "minimum": 0
    },
    "verkehr": {
     "type": "number",
     "minimum": 0
    },
    "gruen": {
     "type": "number",
     "minimum": 0
    },
    "wald": {
     "type": "number",
     "minimum": 0
    },
    "wasser": {
     "type": "number",
     "minimum": 0
    },
    "acker": {
     "type": "number",
     "minimum": 0
    },
    "sonstige": {
     "type": "number",
     "minimum": 0
    }
   },
   "description": "Klassenflächen in ha (0,1 ha gerundet) innerhalb der Einheit und der Stadtgrenze."
  },
  "anteil": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "bebauung",
    "verkehr",
    "gruen",
    "wald",
    "wasser",
    "acker",
    "sonstige",
    "bebauung_verkehr",
    "gruen_wald"
   ],
   "additionalProperties": false,
   "properties": {
    "bebauung": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "verkehr": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "gruen": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "wald": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "wasser": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "acker": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "sonstige": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "bebauung_verkehr": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "gruen_wald": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    }
   },
   "description": "Anteile in Prozent der Summe der Klassenflächen (0,1 Punkte gerundet); bebauung_verkehr und gruen_wald abgeleitet. null: Bezugsfläche zu klein (anteil_grund)."
  },
  "quelle": {
   "type": "object",
   "required": [
    "quelle",
    "vermerk",
    "url"
   ],
   "additionalProperties": false,
   "properties": {
    "quelle": {
     "type": "string",
     "minLength": 1
    },
    "vermerk": {
     "type": "string",
     "minLength": 1
    },
    "url": {
     "type": "string",
     "pattern": "^https://"
    }
   }
  },
  "gruen_grund": {
   "enum": [
    "einwohner_beispieldaten",
    "unter_mindestzahl"
   ]
  }
 }
}

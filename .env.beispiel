# Vorlage für .env des Kiezatlas Kraków. Kopieren nach .env im Wurzelordner dieses Repositorys (neben
# docker-compose.yml), Rechte setzen (chmod 600) und je Rolle ein eigenes, langes Zufallspasswort eintragen, z. B. mit
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Die .env kommt nie ins Repo (.gitignore) und nie in Berichte oder Belege. Arbeit mit mehreren Arbeitskopien:
# docs/rundgang.md, „Datenbank und mehrere Arbeitskopien“.

# Verwalter der Datenbank (Eigentümer, nur für einrichten und Wartung)
POSTGRES_PASSWORD=
# pipeline_import: schreibt die Zieltabellen in public, Rechte vergibt pipeline.einrichten je Spalte
IMPORT_PASSWORD=
# mosidi_lesen: liest public und auswertung, schreibt nichts
LESE_PASSWORD=
# kiezatlas_rechnen: liest public, schreibt Zeilen in auswertung (kein CREATE, ALTER, DROP)
RECHNEN_PASSWORD=

# Optional (Standardwerte in Klammern):
# Port auf 127.0.0.1 (55462)
#PG_PORT=55462
# Rohdaten außerhalb der Repos (../kiezatlas-daten/krakow)
#KIEZ_DATEN=
# Repository der Geodaten-Import-Pipeline (../geodaten-import-pipeline)
#PIPELINE_DIR=
# PIPELINE_ABWEICHUNG=1 gehört nicht hierher: lauf.sh beachtet es nur beim Aufruf (Festschreibung der Pipeline).
